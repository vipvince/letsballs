DEEPSEEK_API_KEY=your_newcoin_or_deepseek_key
DEEPSEEK_BASE_URL=https://api.newcoin.top/v1
DEEPSEEK_MODEL=deepseek-v3.2

# Face++ Detect API — https://console.faceplusplus.com/documents/7078057
# Create key+secret at https://console.faceplusplus.com/
FACEPP_API_KEY=your_facepp_api_key
FACEPP_API_SECRET=your_facepp_api_secret
FACEPP_API_BASE=https://api-us.faceplusplus.com/facepp/v3

# Playwright browser scrape when IG returns login wall (1=on)
USE_BROWSER_IG=1

# Optional: durable DB for Streamlit Cloud (free Turso)
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your_turso_token
